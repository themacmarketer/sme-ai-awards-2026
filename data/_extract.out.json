"{\"cats\":[{\"i\":0,\"label\":\"Innovation Excellence15 winnersAccountin\"},{\"i\":1,\"label\":\"Innovation Excellence15 winnersAccountin\"}],\"winners\":[{\"index\":0,\"listIndex\":0,\"target\":\"Accountingbpo\",\"name\":\"Accountingbpo\",\"tagline\":\"Uses AI to cut accounting document processing time by up to 67%\",\"sectors\":[\"Business Services\"],\"logo\":\"https://services2.imda.gov.sg/ctoaas_assets/ai-awards/accountingbpo.png\",\"description\":\"Professional services firm and business process outsourcing (BPO) provider specialising in tech-enabled financial management, corporate compliance, and digital accounting workflows.\",\"stats\":[{\"main\":\"Up to 67% reduction\",\"sub\":\"in accounting document processing time\"},{\"main\":\"Up to 16x faster\",\"sub\":\"management reporting\"},{\"main\":\"396 manhours\",\"sub\":\"redirected monthly from administrative coordination to client work\"}],\"challenges\":[{\"title\":\"Labour-intensive accounting processes\",\"desc\":\"Manual data entry and reconciliation created heavy administrative work and delayed the timely completion of accounts\"},{\"title\":\"Fragmented work coordination\",\"desc\":\"Assignments and client information were managed across various documents, requiring 400 hours of coordination each month\"},{\"title\":\"Limited ability to scale\",\"desc\":\"Higher client volumes required more manpower, limiting scalability and margins\"}],\"solution\":{\"intro\":\"Yi.Suite: AI Accounting Ecosystem\",\"descMain\":\"An integrated ecosystem of specialised AI solutions built around its accounting workflows\",\"descSub\":\"Yi.Suite connects document processing, client requests, reconciliation, financial reporting and analysis in an end-to-end workflow\",\"items\":[{\"title\":\"Automated document processing\",\"desc\":\"Uses AI to extract information from invoices and accounting documents, suggest accounts and match vendors, and supports batch or single-document processing\"},{\"title\":\"AI-supported work 